# =============================================================================
# proxmox-kvm-swissknife environment configuration
# Copy this file to .env and fill in your values.
# =============================================================================

# -----------------------------------------------------------------------------
# Proxmox VE API
# -----------------------------------------------------------------------------
# Base URL of the Proxmox VE API (include port 8006)
PMX_API_URL=https://pve1.example.com:8006

# Authentication user (format: user@realm, e.g. root@pam, admin@pve)
PMX_USER=root@pam

# API token ID — generate in Datacenter > Permissions > API Tokens
PMX_TOKEN_ID=

# API token secret — displayed once when the token is created
PMX_TOKEN_SECRET=

# Default Proxmox node name to target for operations
PMX_NODE=pve1

# -----------------------------------------------------------------------------
# KVM / libvirt
# -----------------------------------------------------------------------------
# libvirt connection URI (local socket for same-host, or remote SSH+TLS)
LIBVIRT_URI=qemu:///system

# -----------------------------------------------------------------------------
# SSH
# -----------------------------------------------------------------------------
# Default SSH username used when connecting to remote hypervisors
SSH_USER=root

# Absolute path to the SSH private key for remote connections
SSH_KEY_PATH=~/.ssh/id_rsa

# -----------------------------------------------------------------------------
# Notifications
# -----------------------------------------------------------------------------
# Slack incoming webhook URL for job alerts
SLACK_WEBHOOK_URL=

# Telegram bot token obtained from @BotFather
TELEGRAM_BOT_TOKEN=

# Telegram chat or group ID to send notifications to
TELEGRAM_CHAT_ID=

# SMTP server hostname for email notifications
SMTP_HOST=

# SMTP server port (typically 587 for STARTTLS or 465 for implicit TLS)
SMTP_PORT=587

# Sender email address (FROM field)
SMTP_FROM=

# Recipient email address (TO field) — comma-separated for multiple
SMTP_TO=

# ntfy.sh topic URL for push notifications (e.g. https://ntfy.sh/my-topic)
NTFY_URL=

# -----------------------------------------------------------------------------
# Proxmox Backup Server (PBS)
# -----------------------------------------------------------------------------
# PBS API endpoint URL (e.g. https://pbs1.example.com:8007)
PBS_API_URL=

# PBS API authentication token (format: PBSAPIToken=TokenName:TokenValue)
PBS_TOKEN=
